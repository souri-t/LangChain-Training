# OpenAI API設定
# OpenAI互換のAPIキー（必須）
OPENAI_API_KEY=your-api-key-here

# OpenAI互換のAPIエンドポイント（オプション）
# デフォルト: https://api.openai.com/v1
# Azure OpenAIの場合: https://your-resource.openai.azure.com/openai/deployments/your-deployment
OPENAI_API_BASE=https://api.openai.com/v1

# 使用するモデル名（オプション）
# デフォルト: gpt-4
# 例: gpt-4, gpt-3.5-turbo, gpt-4-turbo, etc.
OPENAI_MODEL=gpt-4
